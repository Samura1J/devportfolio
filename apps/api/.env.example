# Copy to .env and fill in. .env is gitignored.
# In development every service key is optional: a missing key turns off just
# that feature (its routes answer 503). In production all but the contact
# keys are required, and the API refuses to start without them.

API_PORT=3000
HOST=127.0.0.1

# Origin visitors use; Stripe redirects back here after checkout.
PUBLIC_URL=http://localhost:5173

# TMDB "API Read Access Token" (the long JWT), not the short v3 API key.
TMDB_READ_TOKEN=

# Stripe secret key. Must be sk_test_… / rk_test_… outside production.
STRIPE_SECRET_KEY=

# https://www.weatherapi.com/my/
WEATHERAPI_KEY=

# Contact form email (optional everywhere). The default sender works for
# sending to your own Resend account address; verify a domain to change it.
RESEND_API_KEY=
CONTACT_TO=
# CONTACT_FROM=Portfolio <onboarding@resend.dev>
